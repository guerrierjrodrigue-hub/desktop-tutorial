# ============================================================================
# Kingdom Athlete — environment variables
#
#   cp .env.example .env.local   then fill in as you activate each backend.
#
# The app runs with ZERO configuration (mock data + demo auth). Every block
# below is optional and only switches on its matching backend. See DEPLOYMENT.md
# for where each value comes from.
# ============================================================================

# --- App ---------------------------------------------------------------------
# Public site URL — used for OAuth redirects, Stripe return URLs, sitemap.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Temporary free-beta mode. When "true", every user is treated as premium and
# /pricing shows a free banner instead of paid plans (monetization code stays
# intact). Leave "false"/unset for the normal paid experience.
APP_FREE_MODE=false

# --- Supabase (auth + Postgres) ---------------------------------------------
# Supabase → Project Settings → API. Without these, auth is a demo redirect and
# all data comes from the mock layer.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role — SERVER ONLY, never expose to the client (Stripe webhook + cron).
SUPABASE_SERVICE_ROLE_KEY=

# --- Coach (Anthropic) ------------------------------------------------------
# Without a key, /api/coach returns warm offline replies instead of live ones.
ANTHROPIC_API_KEY=
# Optional: route Anthropic calls through the Vercel AI Gateway instead.
AI_GATEWAY_API_KEY=

# --- Stripe (subscriptions) -------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Recurring Price IDs from Stripe → Products.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=
# Verified sender, e.g. "Kingdom Athlete <hello@yourdomain.com>".
EMAIL_FROM=

# --- Push notifications (web-push / VAPID) ----------------------------------
# Generate a keypair with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@kingdomathlete.app
# Shared secret the daily reminder cron must present (Vercel Cron sends it).
CRON_SECRET=

# --- Analytics (PostHog) ----------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Error monitoring (Sentry) ----------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Build-time only — required for source-map upload (see next.config.ts).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
